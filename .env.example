# Copy to .env and change the values. Never commit .env.
POSTGRES_DB=geschiedenis
POSTGRES_USER=geschiedenis
POSTGRES_PASSWORD=change-me
# long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=change-me-to-a-long-random-string
# true when the site is served over https (required for live location on phones)
SECURE_COOKIES=false
# load example stories on an empty database
SEED_DEMO=true
MAX_UPLOAD_MB=200
APP_PORT=3000
# host folder for uploaded photos, audio and video
MEDIA_HOST_DIR=./data/media
